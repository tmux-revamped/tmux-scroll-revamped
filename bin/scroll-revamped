#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

scroll_revamped_self="$0"
case "${scroll_revamped_self}" in
*/*) ;;
*) scroll_revamped_self="$(command -v -- "${scroll_revamped_self}")" ;;
esac
scroll_revamped_lib="$(cd "${scroll_revamped_self%/*}/../lib" && pwd)" || exit 1
for scroll_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(SCROLL_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${scroll_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${scroll_revamped_inherited}" ;;
  esac
done
REVAMPED_LIB="${scroll_revamped_lib}"

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/scroll.sh
. "${REVAMPED_LIB}/scroll.sh"

scroll_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=scroll-revamped REVAMPED_UI_VERSION="${SCROLL_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="the mouse wheel where it belongs"
  if [ -n "${SCROLL_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${SCROLL_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=SCROLL_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

scroll_revamped_usage() {
  scroll_revamped_interface
  revamped_cli_usage_error "$1"
}

scroll_revamped_help() {
  revamped_cli_help_page <<'HELP'
scroll-revamped - the mouse wheel to apps that scroll, copy-mode for the rest

usage:
  scroll-revamped apply     bind the wheel now
  scroll-revamped list      print every binding apply would make
  scroll-revamped check ALT MOUSE HISTORY PANE
                            decide one wheel tick on tmux before 2.0: exits 0
                            to pass it to the app, 1 to enter copy-mode
  scroll-revamped doctor    check this machine
  scroll-revamped version   print the version
  scroll-revamped help      print this page

options:
  --json           list prints one JSON object
  --theme NAME     the look: kodougu, catppuccin-mocha, catppuccin-latte,
                   dracula, nord, gruvbox, tokyo-night or mono
  --SETTING VALUE  any tmux option below, named with dashes, such as
                   --wheel on or --speed 3

environment:
  SCROLL_REVAMPED_SETTING  any tmux option below in capitals, such as
                           SCROLL_REVAMPED_WHEEL
  SCROLL_REVAMPED_THEME    the look, when --theme is not given
  SCROLL_REVAMPED_ACCENT   a colour such as #CBA6F7 for the accent
  KODOUGU_THEME            the family look, when neither is given
  KODOUGU_ACCENT           the family accent, when the tool's is unset
  NO_COLOR                 turn colour off

tmux options:
  @scroll_revamped_wheel                  on routes the wheel (off)
  @scroll_revamped_passthrough_alternate  pass the wheel to an app on the
                                          alternate screen (on)
  @scroll_revamped_passthrough_mouse      pass the wheel to an app that asked
                                          for the mouse (on)
  @scroll_revamped_skip_empty             on keeps a pane with no scrollback
                                          out of copy-mode (off)
  @scroll_revamped_select_pane            on focuses the pane under the
                                          pointer first (off)
  @scroll_revamped_alt_keys               arrow or page sends keys to a full
                                          screen app without mouse (none)
  @scroll_revamped_mouse                  off leaves tmux's mouse option
                                          alone (on)
  @scroll_revamped_speed                  lines per copy-mode tick (none)
  @scroll_revamped_granularity            line, halfpage or page (line)
  @scroll_revamped_auto_exit              on leaves copy-mode at the bottom
                                          (off)
  @scroll_revamped_indicator              on flashes the scroll position (off)
  @scroll_revamped_drag_copy              on copies a mouse selection to the
                                          clipboard (off)
  @scroll_revamped_click_copy             on copies the word on a double click
                                          and the line on a triple click to
                                          the clipboard (off)
  @scroll_revamped_smooth                 on scrolls a copy-mode tick one line
                                          at a time (off)
  @scroll_revamped_status_wheel           on switches windows over the status
                                          line (off)
  @revamped_theme                         the family look (kodougu)

notes:
  The entry point runs apply once when tmux loads the plugin, and every
  binding goes to tmux in one call. On tmux 2.0 and later the wheel is decided
  by a format with no process; before 2.0 each tick runs check, which caches
  its last decision in @scroll_revamped_cache_key and _cache_val.

examples:
  scroll-revamped list
  scroll-revamped --wheel on --speed 3 apply
  scroll-revamped doctor
HELP
}

scroll_revamped_version() {
  scroll_revamped_tmux=$(tmux -V 2>/dev/null) || scroll_revamped_tmux=missing
  printf '%s %s\n' scroll-revamped "${SCROLL_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${scroll_revamped_tmux#tmux }"
}

scroll_revamped_doctor_clipboard() {
  scroll_revamped_doctor_clipboard_tool=$(scroll_revamped_clipboard)
  if [ -n "${scroll_revamped_doctor_clipboard_tool}" ]; then
    revamped_doctor_line clipboard ok "${scroll_revamped_doctor_clipboard_tool}"
    return 0
  fi
  revamped_doctor_line clipboard warn "drag and click copy need pbcopy, wl-copy, xclip or xsel"
}

scroll_revamped_doctor_settings() {
  scroll_revamped_doctor_settings_rows=$(scroll_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${SCROLL_REVAMPED_KINDS}" "${scroll_revamped_doctor_settings_rows}"
}

scroll_revamped_doctor() {
  revamped_doctor_tmux
  scroll_revamped_doctor_clipboard
  scroll_revamped_doctor_settings
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed tr
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

scroll_revamped_list() {
  scroll_revamped_plan
  if [ -n "${scroll_revamped_json}" ]; then
    scroll_revamped_json
    return 0
  fi
  scroll_revamped_lines
}

scroll_revamped_apply_command() {
  scroll_revamped_apply
  scroll_revamped_count=$(scroll_revamped_bindings)
  printf 'Applied. %s keys are bound.\n' "${scroll_revamped_count}"
}

scroll_revamped_menu() {
  revamped_cli_require_terminal
  scroll_revamped_choice=$(revamped_cli_menu "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${scroll_revamped_choice}" in
  "List the bindings") scroll_revamped_list ;;
  "Apply them now") scroll_revamped_apply_command ;;
  "Check this machine") scroll_revamped_doctor ;;
  *) scroll_revamped_help ;;
  esac
}

scroll_revamped_dispatch() {
  case "${1:-}" in
  doctor) scroll_revamped_doctor ;;
  version | --version | -V) scroll_revamped_version ;;
  help | --help | -h) scroll_revamped_help ;;
  list) scroll_revamped_list ;;
  "") scroll_revamped_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

scroll_revamped_known() {
  [ "$1" != --theme ] || return 0
  scroll_revamped_known_name=$(scroll_revamped_setting_name "$1")
  [ -n "${scroll_revamped_known_name}" ] || scroll_revamped_usage "unknown option '$1'"
}

scroll_revamped_set() {
  scroll_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "SCROLL_REVAMPED_${scroll_revamped_set_upper}=$2"
}

scroll_revamped_option() {
  scroll_revamped_option_name=$(scroll_revamped_setting_name "$1")
  [ -n "${scroll_revamped_option_name}" ] || scroll_revamped_usage "unknown option '$1'"
  scroll_revamped_set "${scroll_revamped_option_name}" "$2"
}

scroll_revamped_main() {
  scroll_revamped_theme="${SCROLL_REVAMPED_THEME:-}" scroll_revamped_json="" scroll_revamped_count=$# scroll_revamped_rest=0
  while [ "${scroll_revamped_count}" -gt 0 ]; do
    scroll_revamped_arg="$1"
    shift
    scroll_revamped_count=$((scroll_revamped_count - 1))
    case "${scroll_revamped_rest}:${scroll_revamped_arg}" in
    1:*) set -- "$@" "${scroll_revamped_arg}" ;;
    0:--) scroll_revamped_rest=1 ;;
    0:--json) scroll_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${scroll_revamped_arg}" ;;
    0:--theme=*) scroll_revamped_theme="${scroll_revamped_arg#--theme=}" ;;
    0:--*=*) scroll_revamped_option "${scroll_revamped_arg%%=*}" "${scroll_revamped_arg#*=}" ;;
    0:--*)
      scroll_revamped_known "${scroll_revamped_arg}"
      [ "${scroll_revamped_count}" -gt 0 ] || scroll_revamped_usage "option '${scroll_revamped_arg}' needs a value"
      if [ "${scroll_revamped_arg}" = --theme ]; then
        scroll_revamped_theme="$1"
      else
        scroll_revamped_option "${scroll_revamped_arg}" "$1"
      fi
      shift
      scroll_revamped_count=$((scroll_revamped_count - 1))
      ;;
    0:-?*) scroll_revamped_usage "unknown option '${scroll_revamped_arg}'" ;;
    *) set -- "$@" "${scroll_revamped_arg}" ;;
    esac
  done
  scroll_revamped_run "${scroll_revamped_theme}" "$@"
}

scroll_revamped_run() {
  scroll_revamped_run_theme="$1"
  shift
  [ -z "${scroll_revamped_json}" ] || [ "${1:-}" = list ] || scroll_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) scroll_revamped_apply ;;
  check)
    shift
    scroll_revamped_check "$@"
    ;;
  *)
    scroll_revamped_interface
    revamped_cli_start "${scroll_revamped_run_theme}"
    scroll_revamped_dispatch "$@"
    ;;
  esac
}

scroll_revamped_main "$@"
